# Copy to `.env` and fill in. Compose (`docker-compose.prod.yml`) and the
# server both read this file. Empty OIDC values keep email/password sign-in;
# set issuer + client id + secret together to switch to OIDC-only SSO.

# --- server (local `bun start` and Docker) ---
DATABASE_URL=postgres://openrouter:openrouter@localhost:5432/openrouter
PORT=3000
NODE_ENV=development
# Public origin. Auth, /rpc, and /rpc/ws (ws/wss) are derived from this.
BASE_URL=http://localhost:3000
# Expo web/native also accept this; app.config copies BASE_URL into it if unset.
EXPO_PUBLIC_BASE_URL=http://localhost:3000
OPENROUTER_API_KEY=replace-with-openrouter-api-key
OPENROUTER_MODEL=openai/gpt-4o-mini
AUTH_DISABLE_SIGNUP=false
# Expo web export directory. Docker image uses /app/web. Local start skips
# static files when index.html is missing (use `expo start --web` instead).
WEB_DIR=/app/web
# Optional. Seed Better Auth secret on first boot (otherwise generated into kv).
BETTER_AUTH_SECRET=
# Optional legacy alias for BASE_URL.
BETTER_AUTH_URL=

# OIDC SSO (all three required to enable; then OIDC is the only sign-in).
# Callback: {BASE_URL}/api/auth/callback/oidc
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid email profile

# --- docker compose -f docker-compose.prod.yml ---
IMAGE_TAG=latest
POSTGRES_USER=openrouter
POSTGRES_PASSWORD=change-me
POSTGRES_DB=openrouter
DOMAIN=openrouter.brofrong.ru
ACME_EMAIL=you@example.com
# Prod BASE_URL must be https://$DOMAIN (same origin as Caddy).
# BASE_URL=https://openrouter.brofrong.ru
# EXPO_PUBLIC_BASE_URL is baked into the image at build (GitHub Actions var).
