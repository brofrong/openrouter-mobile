{
  "name": "openrouter-mobile",
  "private": true,
  "version": "0.1.0",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "check-types": "turbo run check-types",
    "db:migrate": "bun run --filter @openrouter-mobile/db db:migrate",
    "release": "bun scripts/release.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "turbo": "^2.10.12",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.2"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
